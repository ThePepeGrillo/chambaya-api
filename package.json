{
  "name": "chambaya-api",
  "version": "1.0.0",
  "description": "API REST de ChambaYa (Taller 3): ofertas de trabajo temporal, postulaciones y cupos, con datos en memoria",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
